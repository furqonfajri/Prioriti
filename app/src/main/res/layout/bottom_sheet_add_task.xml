<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounded_top_card"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Your Task"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginVertical="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="10dp">
        <TextView
            android:id="@+id/date_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Date"
            android:layout_weight="1"
            android:background="@color/primary_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="4dp"
            android:inputType="none"
            android:textColor="@color/primary_text"
            android:drawableEnd="@drawable/ic_arrow_down"
            android:drawableTint="@color/primary_text"
            android:drawablePadding="10dp"/>
        <TextView
            android:id="@+id/time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Time"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@color/primary_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:inputType="none"
            android:textColor="@color/primary_text"
            android:drawableEnd="@drawable/ic_arrow_down"
            android:drawableTint="@color/primary_text"
            android:drawablePadding="10dp"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CustomTextInputLayout"
        android:layout_marginVertical="10dp">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/edt_task"
            android:textColorHint="@color/primary_text"
            android:hint="Task"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/CustomTextInputLayout"
        android:layout_marginVertical="10dp">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/edt_description"
            android:textColorHint="@color/primary_text"
            android:hint="Description"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prioriti"
        android:textColor="@color/primary_text"
        android:layout_marginTop="10dp"/>

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rb_low"
            android:layout_weight="1"
            android:textColor="@color/primary_text"
            app:buttonTint="@color/radio_button_selector"
            android:text="Low"/>
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rb_medium"
            android:layout_weight="1"
            android:textColor="@color/primary_text"
            app:buttonTint="@color/radio_button_selector"
            android:text="Medium"/>
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rb_high"
            android:layout_weight="1"
            android:textColor="@color/primary_text"
            app:buttonTint="@color/radio_button_selector"
            android:text="High"/>
    </RadioGroup>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Task"
        android:background="@drawable/button_background"
        app:backgroundTint="@color/calendar_primary"
        android:textColor="@color/third_text"
        android:id="@+id/btn_add_task"/>

</LinearLayout>