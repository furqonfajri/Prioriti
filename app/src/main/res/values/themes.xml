<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Prioriti" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/pale_slate_blue</item>
    </style>

    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <!-- Warna utama untuk TimePicker -->
        <item name="colorPrimary">@color/secondary_background</item>
        <item name="colorOnPrimary">@color/calendar_primary</item>
        <item name="colorSurface">@color/calendar_primary</item>
        <item name="colorOnSurface">@color/secondary_background</item>
        <item name="android:textColor">@color/secondary_background</item>

    </style>

    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">

        <item name="colorPrimary">@color/calendar_primary</item>
        <item name="colorOnPrimary">@color/secondary_background</item>
        <item name="colorSurface">@color/primary_background</item>
        <item name="colorPrimaryVariant">@color/primary_background</item>
    </style>

    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_outline_color</item>
        <item name="hintTextColor">@color/secondary_text</item>
        <item name="android:textColorHint">@color/primary_text</item>
    </style>

    <style name="Theme.Prioriti" parent="Base.Theme.Prioriti" />
</resources>